# D:/spice_parser/CMakeLists.txt
# =============================================================================

# =============================================================================
# Object build statements for EXECUTABLE target spice_tests


#############################################
# Order-only phony target for spice_tests

build cmake_object_order_depends_target_spice_tests: phony || cmake_object_order_depends_target_spice_core

build tests\CMakeFiles\spice_tests.dir\test_main.cpp.obj: CXX_COMPILER__spice_tests_unscanned_Debug D$:\spice_parser\tests\test_main.cpp || cmake_object_order_depends_target_spice_tests
  CONFIG = Debug
  FLAGS = /DWIN32 /D_WINDOWS  /GR /EHsc /MDd /Zi /Ob0 /Od /RTC1 -std:c++17 -MDd /W4 /permissive-
  INCLUDES = -ID:\spice_parser\tests -ID:\spice_parser\src\..\include
  OBJECT_DIR = tests\CMakeFiles\spice_tests.dir
  OBJECT_FILE_DIR = tests\CMakeFiles\spice_tests.dir
  TARGET_COMPILE_PDB = tests\CMakeFiles\spice_tests.dir\
  TARGET_PDB = tests\spice_tests.pdb
  TARGET_SUPPORT_DIR = tests\CMakeFiles\spice_tests.dir


# =============================================================================
# Link build statements for EXECUTABLE target spice_tests


#############################################
# Link the executable tests\spice_tests.exe

build tests\spice_tests.exe: CXX_EXECUTABLE_LINKER__spice_tests_Debug tests\CMakeFiles\spice_tests.dir\test_main.cpp.obj | src\spice_core.lib || src\spice_core.lib
  CONFIG = Debug
  FLAGS = /DWIN32 /D_WINDOWS  /GR /EHsc /MDd /Zi /Ob0 /Od /RTC1 -MDd
  LINK_FLAGS = /machine:x64 /debug /INCREMENTAL /subsystem:console
  LINK_LIBRARIES = src\spice_core.lib  kernel32.lib user32.lib gdi32.lib winspool.lib shell32.lib ole32.lib oleaut32.lib uuid.lib comdlg32.lib advapi32.lib
  OBJECT_DIR = tests\CMakeFiles\spice_tests.dir
  POST_BUILD = cd .
  PRE_LINK = cd .
  TARGET_COMPILE_PDB = tests\CMakeFiles\spice_tests.dir\
  TARGET_FILE = tests\spice_tests.exe
  TARGET_IMPLIB = tests\spice_tests.lib
  TARGET_PDB = tests\spice_tests.pdb
  TARGET_SUPPORT_DIR = tests\CMakeFiles\spice_tests.dir


#############################################
# Utility command for test

build tests\CMakeFiles\test.util: CUSTOM_COMMAND
  COMMAND = C:\WINDOWS\system32\cmd.exe /C "cd /D D:\spice_parser\out\build\x64-Debug\tests && D:\programs\Common7\IDE\CommonExtensions\Microsoft\CMake\CMake\bin\ctest.exe "
  DESC = Running tests...
  pool = console
  restat = 1

build tests\test: phony tests\CMakeFiles\test.util


#############################################
# Utility command for edit_cache

build tests\CMakeFiles\edit_cache.util: CUSTOM_COMMAND
  COMMAND = C:\WINDOWS\system32\cmd.exe /C "cd /D D:\spice_parser\out\build\x64-Debug\tests && D:\programs\Common7\IDE\CommonExtensions\Microsoft\CMake\CMake\bin\cmake.exe -E echo "No interactive CMake dialog available.""
  DESC = No interactive CMake dialog available...
  restat = 1

build tests\edit_cache: phony tests\CMakeFiles\edit_cache.util


#############################################
# Utility command for rebuild_cache

build tests\CMakeFiles\rebuild_cache.util: CUSTOM_COMMAND
  COMMAND = C:\WINDOWS\system32\cmd.exe /C "cd /D D:\spice_parser\out\build\x64-Debug\tests && D:\programs\Common7\IDE\CommonExtensions\Microsoft\CMake\CMake\bin\cmake.exe --regenerate-during-build -SD:\spice_parser -BD:\spice_parser\out\build\x64-Debug"
  DESC = Running CMake to regenerate build system...
  pool = console
  restat = 1

build tests\rebuild_cache: phony tests\CMakeFiles\rebuild_cache.util

# =============================================================================
# Target aliases.

build spice_core: phony src\spice_core.lib

build spice_core.lib: phony src\spice_core.lib

build spice_parser: phony src\spice_parser.exe

build spice_parser.exe: phony src\spice_parser.exe

build spice_tests: phony tests\spice_tests.exe

build spice_tests.exe: phony tests\spice_tests.exe

# =============================================================================
# Folder targets.

# =============================================================================

#############################################
# Folder: D:/spice_parser/out/build/x64-Debug

build all: phony src\all tests\all

# =============================================================================

#############################################
# Folder: D:/spice_parser/out/build/x64-Debug/src

build src\all: phony src\spice_core.lib src\spice_parser.exe

# =============================================================================

#############################################
# Folder: D:/spice_parser/out/build/x64-Debug/tests

build tests\all: phony tests\spice_tests.exe

